# Пример успешного создания VM

$ sudo virt-install \
  --name lab1-vm1 \
  --ram 1024 \
  --vcpus 1 \
  --disk path=/var/lib/libvirt/images/lab1-vm1.qcow2,device=disk,bus=virtio \
  --os-variant ubuntu22.04 \
  --network network=default,model=virtio \
  --graphics none \
  --console pty,target_type=serial \
  --import \
  --noautoconsole

Starting install...
